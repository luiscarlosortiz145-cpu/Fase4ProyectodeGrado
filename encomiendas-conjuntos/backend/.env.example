# Copia este archivo como .env y ajusta los valores
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/encomiendas
JWT_SECRET=cambia-este-secreto-largo
JWT_EXPIRES_IN=8h

# Notificaciones: "simulado" (no envía nada) o "real" (envía correo por SMTP)
NOTIFICACIONES_MODO=simulado
# Solo para el modo real. Con Gmail: verificación en dos pasos + contraseña de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-letras
# Opcional: remitente que ve el residente
# SMTP_FROM=Portería del conjunto <tu_cuenta@gmail.com>

# Opcional: correos de los usuarios de prueba para npm test (si cambiaste los de datos_prueba.sql)
# TEST_CORREO_ADMIN=
# TEST_CORREO_PORTERO=
# TEST_CORREO_RESIDENTE1=
# TEST_CORREO_RESIDENTE2=
